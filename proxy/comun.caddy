# Lo común a proxy/Caddyfile (local) y proxy/Caddyfile.produccion: las
# cabeceras de seguridad y el contenido de cada sitio, como snippets. Cada
# Caddyfile solo pone las direcciones de los sitios, el TLS y la confianza en
# el proxy de delante, e importa aquí el resto: una regla cambiada aquí vale en
# los dos entornos, y lo que las baterías demuestran en local (cabeceras, rutas,
# la quita de Range) es lo que corre en producción.
#
# Los puertos que citan los comentarios (8443, 8444, 8445) son los de local. En
# producción cada sitio tiene su propio nombre (docs/operacion.md): la API, el
# sitio del denunciante y la SPA del personal siguen siendo tres orígenes
# distintos.
#
# Conserva la sangría de los sitios: las baterías construyen sus controles
# buscando estas líneas tal cual (tests/security/verificar_escaneos.py y
# verificar_esqueleto.py).

# Cabeceras de seguridad en snippets: las usan las respuestas normales y las de
# error que genera el propio Caddy. Sin esto, un 413 o un 502 de Caddy saldrían
# con "Server: Caddy" y sin ninguna de ellas (comprobado), como hace nginx sin
# "add_header ... always". Hay tres porque los dos sitios necesitan una CSP y
# una Referrer-Policy distintas: con un único snippet, el defer del de la API
# pisaría las del sitio del denunciante y bloquearía su hoja de estilos.
#
# defer aplica las cabeceras al final de la respuesta, sobre lo que haya puesto
# la API o file_server.
(cabeceras_comunes) {
	header {
		defer
		# Solo HTTPS en los próximos dos años. Sin includeSubDomains ni preload: en
		# local el nombre es localhost, y en producción cada sitio es un nombre
		# sin subdominios propios dentro de eduumr.dev, que comparte con otras
		# aplicaciones (la precarga exigiría includeSubDomains en eduumr.dev
		# entero, que no es de Canario). El dominio .dev entero ya está en la lista
		# de precarga HSTS de los navegadores. HSTS se aplica al host entero, sin
		# distinguir puertos (RFC 6797, 8.3), así que en local cubre los tres
		# sitios. Solo se pone aquí: Traefik no la añade (docs/operacion.md), así
		# no hay dos cabeceras distintas.
		Strict-Transport-Security "max-age=63072000"
		# El navegador no adivina el tipo de contenido: una hoja de estilos solo
		# se aplica si llega como text/css.
		X-Content-Type-Options "nosniff"
		# Ni el navegador ni intermediarios guardan copia de las respuestas.
		# También en el CSS del denunciante: en un equipo compartido, la caché
		# delataría que alguien ha visitado el canal.
		Cache-Control "no-store"
		# No anuncia el servidor.
		-Server
	}
}

# API (8443): solo JSON, nada que cargar ni ejecutar.
(cabeceras_api) {
	import cabeceras_comunes
	header {
		defer
		# Nunca se envía la URL de origen a otro sitio.
		Referrer-Policy "no-referrer"
		# Nada se carga ni se ejecuta, y la respuesta no se puede incrustar.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		# Ninguna respuesta de este puerto pone cookies. No se aíslan por puerto
		# (RFC 6265, 8.5): una puesta aquí valdría también en el 8445, donde
		# viaja la sesión del personal, y serviría para colocarle a alguien la
		# sesión de otro (CSRF de login). Solo el 8445 las pone.
		-Set-Cookie
	}
}

# Sitio del denunciante (8444): HTML sin JavaScript.
(cabeceras_html) {
	import cabeceras_comunes
	header {
		defer
		# same-origin y no no-referrer: con no-referrer, el navegador manda
		# "Origin: null" en los POST de formulario (especificación Fetch, "append
		# a request Origin header"), y la API no podría comprobar el origen de
		# los formularios (app/rutas_web.py). Con same-origin, a otro sitio no
		# sale nada, ni siquiera el origen.
		Referrer-Policy "same-origin"
		# Solo la hoja de estilos propia: ni scripts, ni imágenes, ni fuentes, ni
		# marcos. Los formularios solo envían a este mismo origen (protocolo, host
		# y puerto: el 8443 de la API es otro origen), la página no se puede
		# incrustar y un <base> inyectado no cambia a dónde apuntan los enlaces.
		Content-Security-Policy "default-src 'none'; style-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		# Una ventana de otro origen que abra estas páginas (window.open) no
		# conserva referencia a ellas ni comparte grupo de contexto: no puede
		# navegarlas ni contar sus marcos (OWASP HTTP Headers Cheat Sheet).
		Cross-Origin-Opener-Policy "same-origin"
		# Ningún otro origen puede cargar estas respuestas como recurso, ni
		# siquiera el 8443, que es del mismo sitio: por eso same-origin y no el
		# same-site que recomienda OWASP. Nada de fuera necesita cargarlas.
		# Sin COEP: solo hace falta para el aislamiento entre orígenes, y la
		# CSP ya no deja cargar nada de otro origen.
		Cross-Origin-Resource-Policy "same-origin"
		# Ni cookies: el camino anónimo no deja nada en el navegador, y una
		# puesta aquí valdría en el 8445 (ver cabeceras_api).
		-Set-Cookie
	}
}

# SPA del personal (8445): los ficheros de la SPA y la API del personal, en el
# mismo origen. La misma CSP vale para los dos: la API responde JSON, que no
# ejecuta nada aunque la CSP permita los scripts propios.
(cabeceras_spa) {
	import cabeceras_comunes
	header {
		defer
		# same-origin y no no-referrer, como en el 8444: con no-referrer, algunos
		# POST salen con "Origin: null" (MDN, Origin), y la API exige el origen
		# de la SPA en todo lo que cambia algo (app/rutas_personal.py).
		Referrer-Policy "same-origin"
		# Solo lo propio, comprobado con el build real (bloque 6b-1):
		# - script-src y style-src 'self': index.html no lleva nada en línea
		#   (inlineCritical desactivado en spa/angular.json) y los componentes
		#   no declaran estilos, que Angular inyectaría con <style>. Sin
		#   'unsafe-inline' ni nonces: un HTML inyectado no ejecuta nada.
		# - connect-src 'self': la SPA solo habla con su propio origen (la API
		#   va por /v1/personal). Un script inyectado no puede mandar datos a
		#   otro servidor con fetch. Navegar fuera sí puede (CSP3 no tiene
		#   navigate-to): es un límite asumido (docs/threat-model.md, 8).
		# - Trusted Types: el navegador rechaza asignar un texto a innerHTML y a
		#   los demás sumideros de DOM XSS si no pasa por una política. Solo
		#   existe la de Angular, que sanea lo que recibe; 'angular#unsafe-bypass'
		#   (la de bypassSecurityTrust*) no está permitida. Solo lo aplican los
		#   navegadores basados en Chromium (8).
		# - base-uri 'self' y no 'none': Angular necesita <base href="/"> para
		#   cargar main-*.js, que va con ruta relativa, desde una ruta profunda.
		# - form-action 'none': la SPA envía con fetch, nunca con formularios.
		# - font-src 'self' (bloque 6b-4a): la fuente Geist va en el build
		#   (media/geist-variable-*.woff2). Solo del propio origen: ni un
		#   servidor de fuentes ajeno ve quién abre la SPA, ni una regla
		#   @font-face inyectada podría pedir nada fuera (y no puede haberla:
		#   style-src no admite estilos en línea).
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; require-trusted-types-for 'script'; trusted-types angular; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		# Ningún otro origen carga estas respuestas, tampoco el 8443 ni el 8444,
		# que son del mismo sitio.
		Cross-Origin-Resource-Policy "same-origin"
	}
}

# Quita la cabecera Range de la petición. El binario de la imagen fijada (Go
# 1.26.8) tiene una denegación de servicio con cabeceras Range en ServeContent
# (CVE-2026-78667), que es lo que usa file_server. Sin Range, ServeContent ni
# siquiera la analiza: responde el fichero entero con 200 (comprobado con la
# imagen fijada: con la quita, dos rangos dan 200; sin ella, 206). No se pierde
# nada: los estáticos son pequeños y no hay descargas que reanudar. Se importa
# en todos los sitios, pero lo que la prueba exige (verificar_escaneos.py, f)
# es que vaya delante de cada file_server: un file_server nuevo sin la quita
# falla de forma visible.
(sin_range) {
	request_header -Range
}

# API (8443 en local): solo JSON. Sin las páginas del denunciante.
(sitio_api) {
	import sin_range
	import cabeceras_api

	# Las cookies no se aíslan por puerto (RFC 6265, 8.5): las de la SPA del
	# personal (8445) también las enviaría el navegador aquí. Este puerto es el
	# del cliente con Bearer, así que no pasan a la API: el transporte con
	# cookies solo existe por el 8445 (app/rutas_personal.py).
	request_header -Cookie

	# Tamaño máximo del cuerpo de una petición: 128 KiB, el mismo límite que
	# aplica la API (app/frontera_http.py), que es la segunda capa. KiB y no KB:
	# KB son 1000 bytes.
	request_body {
		max_size 128KiB
	}

	# Las páginas del denunciante (/web) solo se sirven en el 8444, con su CSP
	# y sus cabeceras. Aquí no harían daño (sus formularios exigen el origen del
	# 8444), pero cada puerto expone solo su parte. El matcher path limpia y
	# decodifica la ruta, así que también casan //web/x, /./web/x, /WEB/x y
	# /web%2Fx; /web suelto cubre /web/empresas/.. y similares, que limpios
	# quedan en /web.
	@sitio_denunciante path /web /web/*
	error @sitio_denunciante 404

	reverse_proxy api:8000 {
		# max_size solo falla al leer el cuerpo, y por defecto el proxy lo
		# reenvía mientras lo lee: una petición demasiado grande llegaba a la API
		# (comprobado). Con un buffer algo mayor que el límite, Caddy lee el
		# cuerpo antes de contactar con la API y corta él mismo con 413, como
		# client_max_body_size en nginx. La documentación avisa de que es
		# ineficiente con cuerpos grandes; aquí el máximo es 128 KiB y el tiempo
		# que una conexión puede retener su buffer lo acota read_body.
		request_buffers 129KiB

		# La IP del cliente la decide solo Caddy, y a la API le llega una sola.
		# {client_ip} es la IP de la conexión o, si esta viene de un proxy de
		# confianza (trusted_proxies, solo en Caddyfile.produccion), la primera
		# no confiable leyendo X-Forwarded-For de derecha a izquierda
		# (trusted_proxies_strict). Sin esto, Caddy añade la IP de la conexión
		# al X-Forwarded-For que recibe, uvicorn se queda con la primera no
		# confiable desde la derecha (uvicorn 0.54.0, proxy_headers.py) y en
		# producción esa sería la de Traefik: todos los clientes compartirían
		# el contador del limitador (app/limitador.py). En local no cambia nada:
		# sin proxy de confianza, {client_ip} es la IP de la conexión, la misma
		# que Caddy ya ponía.
		header_up X-Forwarded-For {client_ip}
	}

	# Errores que genera Caddy (cuerpo demasiado grande, API caída): mismas
	# cabeceras y mismo formato JSON que los errores de la API.
	handle_errors {
		import cabeceras_api
		header Content-Type "application/json"

		# El mismo cuerpo que el 404 de la API (app/frontera_http.py, MENSAJES).
		@no_encontrado expression {err.status_code} == 404
		respond @no_encontrado `{"detalle": "recurso no encontrado"}` 404

		@demasiado_grande expression {err.status_code} == 413
		respond @demasiado_grande `{"detalle": "cuerpo de la petición demasiado grande"}` 413

		@no_disponible expression {err.status_code} >= 500
		respond @no_disponible `{"detalle": "servicio no disponible"}` {err.status_code}

		respond `{"detalle": "petición no válida"}` {err.status_code}
	}
}

# Sitio del denunciante, en su propio puerto: es otro origen que la API, así
# que la CSP y form-action se separan por origen sin CORS. No va en un subdominio porque *.localhost no
# resuelve en Windows. Sirve los estáticos y, para todo lo demás, las páginas
# del adaptador HTML de la API (app/rutas_web.py, bajo /web).
(sitio_denunciante) {
	import sin_range
	import cabeceras_html

	# Las cookies no se aíslan por puerto (RFC 6265, 8.5): las de la sesión del
	# personal (8445) también las enviaría el navegador aquí. Las páginas del
	# denunciante no usan ninguna, así que no pasa ninguna a la API: el camino
	# anónimo no lleva nada que identifique.
	request_header -Cookie

	# El mismo límite que en el 8443 y que en la API. El peor caso de un
	# formulario urlencoded cabe: 10 000 caracteres de 4 bytes en UTF-8 son
	# 120 000 bytes con el escapado %XX.
	request_body {
		max_size 128KiB
	}

	# Estáticos desde /srv/estatico, copiados en la imagen (proxy/Dockerfile),
	# de root y con el sistema de ficheros de solo lectura. Sin browse, un
	# directorio sin index da 404 y no un listado. file_server limpia la ruta
	# antes de unirla a root: "../" y "%2e%2e" no salen de /srv (comprobado con
	# la imagen fijada). Solo GET y HEAD; el resto da 405 con "Allow: GET, HEAD".
	handle /estatico/* {
		root * /srv
		# ServeContent anuncia "Accept-Ranges: bytes" aunque Range se haya
		# quitado (comprobado). Se quita para no prometer rangos que no se
		# sirven (RFC 9110, 14.3).
		header -Accept-Ranges
		file_server
	}

	# Todo lo demás va a la API, bajo /web: el visitante ve /seguimiento y la
	# API recibe /web/seguimiento. La API solo sirve HTML en /web, así que el
	# resto de su superficie (/v1, /salud) no es alcanzable desde aquí.
	handle {
		rewrite * /web{uri}

		# Garantía de que lo reenviado está bajo /web. El rewrite no normaliza
		# la ruta (comprobado con la imagen fijada: /web/./v1 llega tal cual),
		# y la API tampoco (uvicorn y Starlette no resuelven "..": /web/../v1
		# casa con las rutas de /web, no con /v1). El matcher path sí limpia y
		# decodifica, así que /../v1, /%2e%2e/v1 o /a/../../v1, que tras el
		# rewrite quedarían en /v1, se rechazan aquí. Defensa en profundidad:
		# no depende de que ninguna pieza posterior normalice o deje de hacerlo.
		@fuera_de_web not path /web/*
		error @fuera_de_web 404

		reverse_proxy api:8000 {
			# Como en el 8443: Caddy lee el cuerpo entero antes de contactar con
			# la API y corta él mismo con 413.
			request_buffers 129KiB

			# Una sola IP, la que decide Caddy (ver el sitio de la API).
			header_up X-Forwarded-For {client_ip}

			# Del backend solo pasa HTML. Lista blanca, no negra: cualquier otra
			# respuesta (los errores JSON de la API, un text/plain de Starlette,
			# una sin tipo) se convierte en la página de error del sitio. Así
			# un camino de error nuevo en la API nunca le enseña JSON a una
			# persona, sin que nadie tenga que acordarse. Se evalúan en orden y
			# gana el primero que casa (comprobado con la imagen fijada).
			@html header Content-Type "text/html*"
			handle_response @html {
				# Solo copy_response: las cabeceras del backend ya están puestas,
				# y copy_response_headers aquí las duplicaba (comprobado).
				copy_response
			}

			# Error de la API: su estado, con su página. Solo se conservan las
			# cabeceras que el navegador necesita: Retry-After (429, 503) y
			# Allow (405). "error" necesita dos argumentos: con uno solo, el
			# valor es el mensaje y el estado queda en 500 (comprobado).
			@error_api status 4xx 5xx
			handle_response @error_api {
				copy_response_headers {
					include Retry-After Allow
				}
				error "error de la API" {rp.status_code}
			}

			# Una respuesta correcta que no es HTML no debe existir en /web: es
			# un fallo, y se ve como tal.
			handle_response {
				error "la API no ha respondido HTML" 500
			}
		}
	}

	# Errores del sitio (ruta inexistente, método no permitido, errores de la
	# API): en HTML, porque los lee una persona en el navegador, y sin detalles
	# internos.
	handle_errors {
		import cabeceras_html
		header Content-Type "text/html; charset=utf-8"

		@no_encontrado expression {err.status_code} == 404
		respond @no_encontrado `<!doctype html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Página no encontrada - Canario</title>
<link rel="stylesheet" href="/estatico/canario.css">
<main>
<h1>Página no encontrada</h1>
</main>
</html>
` 404

		@demasiado_grande expression {err.status_code} == 413
		respond @demasiado_grande `<!doctype html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Texto demasiado largo - Canario</title>
<link rel="stylesheet" href="/estatico/canario.css">
<main>
<h1>Texto demasiado largo</h1>
<p>Lo enviado supera el tamaño máximo. Acorte el texto y vuelva a intentarlo.</p>
</main>
</html>
` 413

		# Muchas personas que usan Tor salen por la misma IP y comparten el
		# límite (docs/threat-model.md, 8): la página lo explica sin culpar a
		# quien la lee. Retry-After llega de la API (copy_response_headers).
		@demasiadas expression {err.status_code} == 429
		respond @demasiadas `<!doctype html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Demasiadas peticiones - Canario</title>
<link rel="stylesheet" href="/estatico/canario.css">
<main>
<h1>Demasiadas peticiones</h1>
<p>Se han recibido demasiadas peticiones desde su conexión. Espere un rato y vuelva a intentarlo.</p>
</main>
</html>
` 429

		@no_disponible expression {err.status_code} >= 500
		respond @no_disponible `<!doctype html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Servicio no disponible - Canario</title>
<link rel="stylesheet" href="/estatico/canario.css">
<main>
<h1>Servicio no disponible</h1>
</main>
</html>
` {err.status_code}

		respond `<!doctype html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Petición no válida - Canario</title>
<link rel="stylesheet" href="/estatico/canario.css">
<main>
<h1>Petición no válida</h1>
</main>
</html>
` {err.status_code}
	}
}

# SPA del personal, en su propio origen (CANARIO_ORIGEN_PERSONAL, en el
# compose). La SPA y la API que usa comparten origen: /v1/personal/* se reenvía
# a la API y la SPA la llama sin CORS, así que no hay ninguna regla de CORS que
# configurar mal. Es el único puerto por el que viajan las cookies de sesión
# del personal (app/rutas_personal.py).
(sitio_spa) {
	import sin_range
	import cabeceras_spa

	# ServeContent anuncia "Accept-Ranges: bytes" aunque Range se haya quitado
	# (ver el sitio del 8444). Aquí va en todo el sitio: la API no la pone, y
	# así ningún file_server de la SPA queda sin la quita.
	header -Accept-Ranges

	# El mismo límite que en el 8443 y que en la API.
	request_body {
		max_size 128KiB
	}

	# De la API, solo la del personal. El resto (/v1/empresas, /v1/seguimiento,
	# /web, /salud) no es alcanzable desde aquí: el camino anónimo nunca recibe
	# las cookies del personal. El matcher path limpia y decodifica, así que
	# /v1/personal/../empresas o /v1/personal/%2e%2e/seguimiento no casan. Lo
	# que casa llega a la API tal cual, y Starlette no resuelve "..": una ruta
	# como /v1/empresas/../personal/yo no es ninguna de la API (404).
	handle /v1/personal/* {
		reverse_proxy api:8000 {
			# Como en el 8443: Caddy lee el cuerpo entero antes de contactar con
			# la API y corta él mismo con 413.
			request_buffers 129KiB

			# Una sola IP, la que decide Caddy (ver el sitio de la API).
			header_up X-Forwarded-For {client_ip}
		}
	}

	# El resto de /v1 es la API, aunque no se reenvíe: 404 en JSON, como lo
	# espera quien llama a la API, y no la página de la SPA.
	@resto_api path /v1 /v1/*
	handle @resto_api {
		error 404
	}

	# La SPA, desde /srv/spa (copiada en la imagen de root, proxy/Dockerfile).
	# Tres casos, en orden:
	# 1. Un fichero que existe (index.html, main-*.js, styles-*.css): se sirve.
	#    "/" es el directorio y file_server sirve su index.html. Sin browse.
	# 2. Una ruta con extensión que no existe (un main-*.js de otra versión):
	#    404. Si diera index.html, el navegador recibiría HTML donde espera un
	#    script, y el fallo quedaría escondido.
	# 3. Cualquier otra ruta es de la SPA (/denuncias/x): index.html, y el
	#    router de Angular pinta la página o "Página no encontrada". Ninguna
	#    ruta de la SPA lleva un punto (spa/src/app/app.routes.ts).
	# Solo GET y HEAD; file_server responde 405 al resto.
	handle {
		root * /srv/spa

		@fichero file
		handle @fichero {
			file_server
		}

		@con_extension path_regexp \.[^/]*$
		handle @con_extension {
			error 404
		}

		handle {
			rewrite * /index.html
			file_server
		}
	}

	# Errores que genera Caddy: los lee la SPA, con el formato JSON de la API.
	handle_errors {
		import cabeceras_spa
		header Content-Type "application/json"

		@no_encontrado expression {err.status_code} == 404
		respond @no_encontrado `{"detalle": "recurso no encontrado"}` 404

		@demasiado_grande expression {err.status_code} == 413
		respond @demasiado_grande `{"detalle": "cuerpo de la petición demasiado grande"}` 413

		@no_disponible expression {err.status_code} >= 500
		respond @no_disponible `{"detalle": "servicio no disponible"}` {err.status_code}

		respond `{"detalle": "petición no válida"}` {err.status_code}
	}
}

# Sitio por defecto: cualquier petición cuyo Host no sea el de un sitio. Sin
# él, no casaría con ninguna ruta y Caddy respondería 200 vacío. Responde 421
# con las cabeceras y el formato JSON de la API: nadie llega aquí desde un
# enlace del sitio, solo con un Host manipulado.
(sitio_por_defecto) {
	import sin_range
	import cabeceras_api
	header Content-Type "application/json"
	respond `{"detalle": "host no válido"}` 421
}

# Proxy inverso de Canario: única puerta desde el exterior hacia la API.
#
# Sin directiva "log" en ningún sitio: no hay logs de acceso. Si se declarase,
# cada petición quedaría registrada con la IP del cliente (ver
# docs/threat-model.md, 6.8).
{
	# Sin API de administración: nadie puede cambiar la configuración en caliente.
	# Para cambiarla hay que reconstruir la imagen y reiniciar el contenedor.
	admin off

	# No guarda copia de la configuración (autosave.json) en /config. admin off no
	# lo desactiva por sí solo (comprobado en el código de Caddy), y así /config
	# queda de solo lectura.
	persist_config off

	# Sin servidor de redirección HTTP a HTTPS: no se escucha en el puerto 80 ni
	# se publica HTTP.
	auto_https disable_redirects

	# El CA local no se intenta instalar en el almacén de confianza del sistema:
	# el contenedor no es root y no tiene almacén que tocar.
	skip_install_trust

	servers {
		# Solo HTTP/1.1 sobre TCP. Sin HTTP/3 no hay listener UDP que no se publica
		# ni se usa. Sin HTTP/2 mientras el binario de la imagen fijada lleve Go
		# 1.26.8 y golang.org/x/net 0.59.0: CVE-2026-78669 (denegación de servicio
		# con tramas SETTINGS de HTTP/2) tiene arreglo en Go 1.26.9 pero no hay
		# imagen oficial de Caddy que lo traiga. Sin h2 el código vulnerable no es
		# alcanzable; una API sin frontend no pierde nada con HTTP/1.1, y el
		# reenvío a la API ya era HTTP/1.1. Se vuelve a "h1 h2" con la imagen que
		# traiga el arreglo (tests/security/verificar_escaneos.py y
		# tests/security/canario.openvex.json lo vigilan).
		protocols h1

		# Sin strict_sni_host: su 421 lo genera el servidor antes de entrar en las
		# rutas, y salía con "Server: Caddy" y sin cabeceras de seguridad
		# (comprobado). Lo sustituye el sitio por defecto del final del fichero,
		# que responde 421 a cualquier Host distinto de localhost por las rutas,
		# con las mismas cabeceras. Un SNI distinto ni siquiera completa el TLS:
		# solo hay certificado para localhost.

		# Sin trusted_proxies: Caddy no confía en ningún proxy, así que ignora el
		# X-Forwarded-For entrante y pone la IP real de la conexión.

		# Plazos explícitos. Por defecto Caddy no limita la lectura del cuerpo ni
		# la escritura (documentación oficial: "Defaults to no timeout"): un
		# cliente que envía un byte cada pocos segundos retendría la conexión
		# para siempre (slowloris), y con request_buffers también su buffer.
		# 30 s para el cuerpo dan margen a un denunciante por Tor, con poco
		# ancho de banda, para subir el máximo de 128 KiB.
		timeouts {
			read_header 10s
			read_body 30s
			write 30s
			idle 2m
		}
	}

	# Logs de runtime (errores, avisos). Pueden llevar IPs de clientes.
	log default {
		# http.stdlib son mensajes del servidor HTTP de Go (por ejemplo errores de
		# handshake TLS) con la IP dentro del texto. El campo msg no se puede
		# filtrar, así que se excluye el logger entero.
		exclude http.stdlib

		# En el resto se BORRAN los campos con IP. No se usa hash (conserva 4 bytes
		# de SHA-256, invertible por fuerza bruta sobre IPv4) ni ip_mask (deja
		# parte de la dirección).
		format filter {
			wrap json
			fields {
				remote_ip delete
				remote_port delete
				client_ip delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Forwarded delete
			}
		}
	}
}

# Cabeceras de seguridad para una API sin frontend, en un único sitio: las usan
# las respuestas normales y las de error que genera el propio Caddy. Sin esto,
# un 413 o un 502 de Caddy saldrían con "Server: Caddy" y sin ninguna de ellas
# (comprobado), como hace nginx sin "add_header ... always".
(cabeceras_seguridad) {
	# defer las aplica al final de la respuesta, sobre lo que haya puesto la API.
	header {
		defer
		# Solo HTTPS en los próximos dos años. Sin includeSubDomains ni preload: el
		# nombre es localhost. Se revisará con el dominio real.
		Strict-Transport-Security "max-age=63072000"
		# El navegador no adivina el tipo de contenido.
		X-Content-Type-Options "nosniff"
		# Nunca se envía la URL de origen a otro sitio.
		Referrer-Policy "no-referrer"
		# Nada se carga ni se ejecuta, y la respuesta no se puede incrustar.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		# Ni el navegador ni intermediarios guardan copia de las respuestas.
		Cache-Control "no-store"
		# No anuncia el servidor.
		-Server
	}
}

# Certificado del CA interno de Caddy (tls internal): sin ACME y sin necesidad de
# internet. Escucha en 8443 (no privilegiado), así no hace falta
# NET_BIND_SERVICE. Docker lo publica solo en 127.0.0.1 del host.
https://localhost:8443 {
	tls internal

	import cabeceras_seguridad

	# Tamaño máximo del cuerpo de una petición: 128 KiB, el mismo límite que
	# aplica la API (app/frontera_http.py), que es la segunda capa. KiB y no KB:
	# KB son 1000 bytes.
	request_body {
		max_size 128KiB
	}

	reverse_proxy api:8000 {
		# max_size solo falla al leer el cuerpo, y por defecto el proxy lo
		# reenvía mientras lo lee: una petición demasiado grande llegaba a la API
		# (comprobado). Con un buffer algo mayor que el límite, Caddy lee el
		# cuerpo antes de contactar con la API y corta él mismo con 413, como
		# client_max_body_size en nginx. La documentación avisa de que es
		# ineficiente con cuerpos grandes; aquí el máximo es 128 KiB y el tiempo
		# que una conexión puede retener su buffer lo acota read_body.
		request_buffers 129KiB
	}

	# Errores que genera Caddy (cuerpo demasiado grande, API caída): mismas
	# cabeceras y mismo formato JSON que los errores de la API.
	handle_errors {
		import cabeceras_seguridad
		header Content-Type "application/json"

		@demasiado_grande expression {err.status_code} == 413
		respond @demasiado_grande `{"detalle": "cuerpo de la petición demasiado grande"}` 413

		@no_disponible expression {err.status_code} >= 500
		respond @no_disponible `{"detalle": "servicio no disponible"}` {err.status_code}

		respond `{"detalle": "petición no válida"}` {err.status_code}
	}
}

# Sitio por defecto: cualquier petición cuyo Host no sea localhost. Sin él, no
# casaría con ninguna ruta y Caddy respondería 200 vacío. Responde 421 con las
# mismas cabeceras y el mismo formato JSON que el resto.
https://:8443 {
	tls internal
	import cabeceras_seguridad
	header Content-Type "application/json"
	respond `{"detalle": "host no válido"}` 421
}

# Proxy inverso de Canario en local: única puerta desde el exterior. En 8443,
# la API; en 8444, el sitio del denunciante; en 8445, la SPA del personal. El
# de producción, detrás de Traefik, es proxy/Caddyfile.produccion. Lo común a
# los dos está en global.caddy, servidor.caddy y comun.caddy.
#
# Sin directiva "log" en ningún sitio: no hay logs de acceso. Si se declarase,
# cada petición quedaría registrada con la IP del cliente (ver
# docs/threat-model.md, 6.8).
{
	import global.caddy

	servers {
		import servidor.caddy

		# Sin trusted_proxies: Caddy no confía en ningún proxy, así que ignora el
		# X-Forwarded-For entrante y pone la IP real de la conexión.
	}
}

import comun.caddy

# Certificado del CA interno de Caddy (tls internal): sin ACME y sin necesidad de
# internet. Escucha en 8443 (no privilegiado), así no hace falta
# NET_BIND_SERVICE. Docker lo publica solo en 127.0.0.1 del host.
https://localhost:8443 {
	tls internal
	import sitio_api
}

https://localhost:8444 {
	tls internal
	import sitio_denunciante
}

https://localhost:8445 {
	tls internal
	import sitio_spa
}

# Sitio por defecto de los tres puertos. Un SNI distinto de localhost ni
# siquiera completa el TLS: solo hay certificado para localhost.
https://:8443, https://:8444, https://:8445 {
	tls internal
	import sitio_por_defecto
}

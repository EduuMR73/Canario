# Proxy inverso de Canario: única puerta desde el exterior. En 8443, la API; en
# 8444, el sitio del denunciante.
#
# Sin directiva "log" en ningún sitio: no hay logs de acceso. Si se declarase,
# cada petición quedaría registrada con la IP del cliente (ver
# docs/threat-model.md, 6.8).
{
	# Sin API de administración: nadie puede cambiar la configuración en caliente.
	# Para cambiarla hay que reconstruir la imagen y reiniciar el contenedor.
	admin off

	# No guarda copia de la configuración (autosave.json) en /config. admin off no
	# lo desactiva por sí solo (comprobado en el código de Caddy), y así /config
	# queda de solo lectura.
	persist_config off

	# Sin servidor de redirección HTTP a HTTPS: no se escucha en el puerto 80 ni
	# se publica HTTP.
	auto_https disable_redirects

	# El CA local no se intenta instalar en el almacén de confianza del sistema:
	# el contenedor no es root y no tiene almacén que tocar.
	skip_install_trust

	servers {
		# Solo HTTP/1.1 sobre TCP. Sin HTTP/3 no hay listener UDP que no se publica
		# ni se usa. Sin HTTP/2 mientras el binario de la imagen fijada lleve Go
		# 1.26.8 y golang.org/x/net 0.59.0: CVE-2026-78669 (denegación de servicio
		# con tramas SETTINGS de HTTP/2) tiene arreglo en Go 1.26.9 pero no hay
		# imagen oficial de Caddy que lo traiga. Sin h2 el código vulnerable no es
		# alcanzable; una API sin frontend no pierde nada con HTTP/1.1, y el
		# reenvío a la API ya era HTTP/1.1. Se vuelve a "h1 h2" con la imagen que
		# traiga el arreglo (tests/security/verificar_escaneos.py y
		# tests/security/canario.openvex.json lo vigilan).
		protocols h1

		# Sin strict_sni_host: su 421 lo genera el servidor antes de entrar en las
		# rutas, y salía con "Server: Caddy" y sin cabeceras de seguridad
		# (comprobado). Lo sustituye el sitio por defecto del final del fichero,
		# que responde 421 a cualquier Host distinto de localhost por las rutas,
		# con las mismas cabeceras. Un SNI distinto ni siquiera completa el TLS:
		# solo hay certificado para localhost.

		# Sin trusted_proxies: Caddy no confía en ningún proxy, así que ignora el
		# X-Forwarded-For entrante y pone la IP real de la conexión.

		# Plazos explícitos. Por defecto Caddy no limita la lectura del cuerpo ni
		# la escritura (documentación oficial: "Defaults to no timeout"): un
		# cliente que envía un byte cada pocos segundos retendría la conexión
		# para siempre (slowloris), y con request_buffers también su buffer.
		# 30 s para el cuerpo dan margen a un denunciante por Tor, con poco
		# ancho de banda, para subir el máximo de 128 KiB.
		timeouts {
			read_header 10s
			read_body 30s
			write 30s
			idle 2m
		}
	}

	# Logs de runtime (errores, avisos). Pueden llevar IPs de clientes.
	log default {
		# http.stdlib son mensajes del servidor HTTP de Go (por ejemplo errores de
		# handshake TLS) con la IP dentro del texto. El campo msg no se puede
		# filtrar, así que se excluye el logger entero.
		exclude http.stdlib

		# En el resto se BORRAN los campos con IP. No se usa hash (conserva 4 bytes
		# de SHA-256, invertible por fuerza bruta sobre IPv4) ni ip_mask (deja
		# parte de la dirección).
		format filter {
			wrap json
			fields {
				remote_ip delete
				remote_port delete
				client_ip delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Forwarded delete
			}
		}
	}
}

# Cabeceras de seguridad en snippets: las usan las respuestas normales y las de
# error que genera el propio Caddy. Sin esto, un 413 o un 502 de Caddy saldrían
# con "Server: Caddy" y sin ninguna de ellas (comprobado), como hace nginx sin
# "add_header ... always". Hay tres porque los dos sitios necesitan una CSP y
# una Referrer-Policy distintas: con un único snippet, el defer del de la API
# pisaría las del sitio del denunciante y bloquearía su hoja de estilos.
#
# defer aplica las cabeceras al final de la respuesta, sobre lo que haya puesto
# la API o file_server.
(cabeceras_comunes) {
	header {
		defer
		# Solo HTTPS en los próximos dos años. Sin includeSubDomains ni preload: el
		# nombre es localhost. Se revisará con el dominio real. HSTS se aplica al
		# host entero, sin distinguir puertos (RFC 6797, 8.3), así que cubre los
		# dos sitios.
		Strict-Transport-Security "max-age=63072000"
		# El navegador no adivina el tipo de contenido: una hoja de estilos solo
		# se aplica si llega como text/css.
		X-Content-Type-Options "nosniff"
		# Ni el navegador ni intermediarios guardan copia de las respuestas.
		# También en el CSS del denunciante: en un equipo compartido, la caché
		# delataría que alguien ha visitado el canal.
		Cache-Control "no-store"
		# No anuncia el servidor.
		-Server
	}
}

# API (8443): solo JSON, nada que cargar ni ejecutar.
(cabeceras_api) {
	import cabeceras_comunes
	header {
		defer
		# Nunca se envía la URL de origen a otro sitio.
		Referrer-Policy "no-referrer"
		# Nada se carga ni se ejecuta, y la respuesta no se puede incrustar.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	}
}

# Sitio del denunciante (8444): HTML sin JavaScript.
(cabeceras_html) {
	import cabeceras_comunes
	header {
		defer
		# same-origin y no no-referrer: con no-referrer, el navegador manda
		# "Origin: null" en los POST de formulario (especificación Fetch, "append
		# a request Origin header"), y la API no podría comprobar el origen de
		# los formularios del bloque siguiente. Con same-origin, a otro sitio no
		# sale nada, ni siquiera el origen.
		Referrer-Policy "same-origin"
		# Solo la hoja de estilos propia: ni scripts, ni imágenes, ni fuentes, ni
		# marcos. Los formularios solo envían a este mismo origen (protocolo, host
		# y puerto: el 8443 de la API es otro origen), la página no se puede
		# incrustar y un <base> inyectado no cambia a dónde apuntan los enlaces.
		Content-Security-Policy "default-src 'none'; style-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
	}
}

# Quita la cabecera Range de la petición. El binario de la imagen fijada (Go
# 1.26.8) tiene una denegación de servicio con cabeceras Range en ServeContent
# (CVE-2026-78667), que es lo que usa file_server. Sin Range, ServeContent ni
# siquiera la analiza: responde el fichero entero con 200 (comprobado con la
# imagen fijada: con la quita, dos rangos dan 200; sin ella, 206). No se pierde
# nada: los estáticos son pequeños y no hay descargas que reanudar. Se importa
# en todos los sitios, pero lo que la prueba exige (verificar_escaneos.py, f)
# es que vaya delante de cada file_server: un file_server nuevo sin la quita
# falla de forma visible.
(sin_range) {
	request_header -Range
}

# Certificado del CA interno de Caddy (tls internal): sin ACME y sin necesidad de
# internet. Escucha en 8443 (no privilegiado), así no hace falta
# NET_BIND_SERVICE. Docker lo publica solo en 127.0.0.1 del host.
https://localhost:8443 {
	tls internal

	import sin_range
	import cabeceras_api

	# Tamaño máximo del cuerpo de una petición: 128 KiB, el mismo límite que
	# aplica la API (app/frontera_http.py), que es la segunda capa. KiB y no KB:
	# KB son 1000 bytes.
	request_body {
		max_size 128KiB
	}

	reverse_proxy api:8000 {
		# max_size solo falla al leer el cuerpo, y por defecto el proxy lo
		# reenvía mientras lo lee: una petición demasiado grande llegaba a la API
		# (comprobado). Con un buffer algo mayor que el límite, Caddy lee el
		# cuerpo antes de contactar con la API y corta él mismo con 413, como
		# client_max_body_size en nginx. La documentación avisa de que es
		# ineficiente con cuerpos grandes; aquí el máximo es 128 KiB y el tiempo
		# que una conexión puede retener su buffer lo acota read_body.
		request_buffers 129KiB
	}

	# Errores que genera Caddy (cuerpo demasiado grande, API caída): mismas
	# cabeceras y mismo formato JSON que los errores de la API.
	handle_errors {
		import cabeceras_api
		header Content-Type "application/json"

		@demasiado_grande expression {err.status_code} == 413
		respond @demasiado_grande `{"detalle": "cuerpo de la petición demasiado grande"}` 413

		@no_disponible expression {err.status_code} >= 500
		respond @no_disponible `{"detalle": "servicio no disponible"}` {err.status_code}

		respond `{"detalle": "petición no válida"}` {err.status_code}
	}
}

# Sitio del denunciante, en su propio puerto: es otro origen que la API, así
# que la CSP, las cookies del personal (bloque siguiente) y form-action se
# separan por origen sin CORS. No va en un subdominio porque *.localhost no
# resuelve en Windows. Por ahora solo sirve la hoja de estilos base; las páginas
# llegan con el adaptador HTML de la API.
https://localhost:8444 {
	tls internal

	import sin_range
	import cabeceras_html

	# Estáticos desde /srv/estatico, copiados en la imagen (proxy/Dockerfile),
	# de root y con el sistema de ficheros de solo lectura. Sin browse, un
	# directorio sin index da 404 y no un listado. file_server limpia la ruta
	# antes de unirla a root: "../" y "%2e%2e" no salen de /srv (comprobado con
	# la imagen fijada). Solo GET y HEAD; el resto da 405 con "Allow: GET, HEAD".
	handle /estatico/* {
		root * /srv
		# ServeContent anuncia "Accept-Ranges: bytes" aunque Range se haya
		# quitado (comprobado). Se quita para no prometer rangos que no se
		# sirven (RFC 9110, 14.3).
		header -Accept-Ranges
		file_server
	}

	# Cualquier otra ruta, 404. Con "error" y no con "respond", para que pase
	# por handle_errors y todos los errores del sitio salgan de un único sitio
	# con el mismo HTML y las mismas cabeceras.
	handle {
		error 404
	}

	# Errores del sitio (ruta o fichero inexistente, método no permitido): en
	# HTML, porque los lee una persona en el navegador, y sin detalles internos.
	handle_errors {
		import cabeceras_html
		header Content-Type "text/html; charset=utf-8"

		@no_encontrado expression {err.status_code} == 404
		respond @no_encontrado `<!doctype html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Página no encontrada - Canario</title>
<link rel="stylesheet" href="/estatico/canario.css">
<main>
<h1>Página no encontrada</h1>
</main>
</html>
` 404

		@no_disponible expression {err.status_code} >= 500
		respond @no_disponible `<!doctype html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Servicio no disponible - Canario</title>
<link rel="stylesheet" href="/estatico/canario.css">
<main>
<h1>Servicio no disponible</h1>
</main>
</html>
` {err.status_code}

		respond `<!doctype html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Petición no válida - Canario</title>
<link rel="stylesheet" href="/estatico/canario.css">
<main>
<h1>Petición no válida</h1>
</main>
</html>
` {err.status_code}
	}
}

# Sitio por defecto de los dos puertos: cualquier petición cuyo Host no sea
# localhost. Sin él, no casaría con ninguna ruta y Caddy respondería 200 vacío.
# Responde 421 con las cabeceras y el formato JSON de la API: nadie llega aquí
# desde un enlace del sitio, solo con un Host manipulado.
https://:8443, https://:8444 {
	tls internal
	import sin_range
	import cabeceras_api
	header Content-Type "application/json"
	respond `{"detalle": "host no válido"}` 421
}
